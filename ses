CALCULATOR ============================================================

Calculator.java

public class Calculator { public int add(int a, int b) { return a + b; }
public int subtract(int a, int b) { return a - b; } public int
multiply(int a, int b) { return a * b; }

    public double divide(double a, double b) {
        if (b == 0) throw new IllegalArgumentException("Cannot divide by zero");
        return a / b;
    }

}

CalculatorTest.java

import org.junit.Test; import static org.junit.Assert.*;

public class CalculatorTest { Calculator c = new Calculator();

    @Test public void testAdd() {
        assertEquals(15, c.add(10, 5));
    }

    @Test public void testSubtract() {
        assertEquals(5, c.subtract(10, 5));
    }

    @Test public void testMultiply() {
        assertEquals(50, c.multiply(10, 5));
    }

    @Test public void testDivide() {
        assertEquals(2.0, c.divide(10, 5), 0.001);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testDivideByZero() {
        c.divide(10, 0);
